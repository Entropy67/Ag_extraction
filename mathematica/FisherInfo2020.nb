Cell[BoxData[{
 RowBox[{"Clear", "[", "prob", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prob", "[", 
   RowBox[{"y_", ",", " ", "nB_", ",", " ", "eb_", ",", " ", "a_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"a", "/", 
    RowBox[{"(", 
     RowBox[{"nB", "-", "1"}], ")"}]}], " ", "*", 
   RowBox[{"y", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "/", 
       RowBox[{"(", 
        RowBox[{"nB", "-", "1"}], ")"}]}], "-", "1"}], ")"}]}], 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"nB", "-", "1"}], ")"}], "  ", 
      RowBox[{"eb", "/", 
       RowBox[{"(", "nB", ")"}]}]}], "]"}], "/", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"y", "^", "a"}], " ", "+", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nB", "-", "1"}], ")"}], 
         RowBox[{"eb", "/", "nB"}]}], "]"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"nB", "/", 
       RowBox[{"(", 
        RowBox[{"nB", "-", "1"}], ")"}]}], ")"}]}]}]}]}]}], "Input",
 CellChangeTimes->{{3.8219258247246017`*^9, 3.8219259889696627`*^9}, {
  3.821926046884028*^9, 3.82192606281845*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"2ba4baa5-48ba-4226-8270-cd30863f9011"],

