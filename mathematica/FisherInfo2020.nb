Cell[BoxData[
 RowBox[{"        ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "b"}], "-", "1"}], ")"}]}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"y", "^", "a"}], "+", "c"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"b", "+", "2"}], ")"}]}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8219270313362417`*^9, 3.821927032338904*^9}, {
  3.821927183297168*^9, 3.821927221638426*^9}, {3.821927294928831*^9, 
  3.821927297127619*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"a5c6482d-4005-411f-9be0-a1cfeb73528d"],

Cell[BoxData[
 TemplateBox[{
   FractionBox["1", 
    RowBox[{"a", " ", 
      RowBox[{"(", 
        RowBox[{"b", "+", 
          SuperscriptBox["b", "2"]}], ")"}], " ", 
      SuperscriptBox["c", "2"]}]], 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", 
       StyleBox[
        TagBox[
         TooltipBox["\"condition\"", 
          TagBox[
           RowBox[{
             RowBox[{
               RowBox[{"b", " ", 
                 RowBox[{"Arg", "[", 
                   FractionBox["1", "c"], "]"}]}], "\[LessEqual]", "\[Pi]"}], 
             "&&", 
             RowBox[{
               RowBox[{"Re", "[", "a", "]"}], ">", "0"}], "&&", 
             RowBox[{
               RowBox[{"Re", "[", 
                 RowBox[{"a", " ", "b"}], "]"}], ">", "0"}], "&&", 
             RowBox[{"(", 
               RowBox[{
                 RowBox[{
                   RowBox[{"Re", "[", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "c"}], ")"}], 
                    FractionBox["1", "a"]], "]"}], "\[LessEqual]", "0"}], 
                 "||", 
                 RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "c"}], ")"}], 
                    FractionBox["1", "a"]], "\[NotElement]", 
                   TemplateBox[{}, "Reals"]}]}], ")"}], "&&", 
             RowBox[{
               RowBox[{"Re", "[", "c", "]"}], ">", "0"}]}], Short[#, 7]& ]], 
         Annotation[#, 
          Short[
           
           And[$CellContext`b Arg[$CellContext`c^(-1)] <= Pi, 
            Re[$CellContext`a] > 0, Re[$CellContext`a $CellContext`b] > 0, 
            Or[Re[(-$CellContext`c)^($CellContext`a^(-1))] <= 0, 
             NotElement[(-$CellContext`c)^($CellContext`a^(-1)), Reals]], 
            Re[$CellContext`c] > 0], 7], "Tooltip"]& ], "IconizedCustomName", 
        StripOnInput -> False], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["And", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["1360", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]}, "IconizedObject"]], 
    And[$CellContext`b Arg[$CellContext`c^(-1)] <= Pi, Re[$CellContext`a] > 0,
      Re[$CellContext`a $CellContext`b] > 0, 
     Or[Re[(-$CellContext`c)^($CellContext`a^(-1))] <= 0, 
      NotElement[(-$CellContext`c)^($CellContext`a^(-1)), Reals]], 
     Re[$CellContext`c] > 0], SelectWithContents -> True, Selectable -> 
    False]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.821927228605441*^9, 3.821927328177443*^9},
 CellLabel->
  "Out[185]=",ExpressionUUID->"1eed1c28-92a8-49f1-b60c-43d9d4ff1473"]
