           RowBox[{"nc", "-", "m"}], ")"}]}], 
         RowBox[{
          RowBox[{"FactorialPower", "[", 
           RowBox[{"nc", ",", " ", "m"}], "]"}], "/", 
          RowBox[{"Factorial", "[", "m", "]"}]}]}]}], "\[IndentingNewLine]", 
       "]"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
