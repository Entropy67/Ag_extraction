Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"Pm", ",", " ", "mAve"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pm", "[", 
    RowBox[{
    "m_", ",", " ", "t_", ",", " ", "eb_", ",", "ea_", ",", " ", "nc_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xa", "=", "1.5"}], ",", " ", 
       RowBox[{"xb", "=", "2.0"}], ",", " ", 
       RowBox[{"f", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"koffAPC", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"ea", ",", " ", "xa", ",", " ", "f"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"koffb", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"eb", ",", " ", "xb", ",", " ", "f"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"koffb", " ", "+", " ", "koffAPC"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "\[Equal]", "0"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", "\[Equal]", "nc"}], ",", " ", "1", ",", " ", "0"}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "a"}], " ", "t", " ", "m"}], "]"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "a"}], " ", "t"}], "]"}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"nc", "-", "m"}], ")"}]}], 
         RowBox[{
          RowBox[{"FactorialPower", "[", 
           RowBox[{"nc", ",", " ", "m"}], "]"}], "/", 
          RowBox[{"Factorial", "[", "m", "]"}]}]}]}], "\[IndentingNewLine]", 
       "]"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mAve", "[", 
   RowBox[{"t_", ",", " ", "eb_", ",", "ea_", ",", " ", "nc_"}], "]"}], ":=", 
  
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"m", " ", 
     RowBox[{"Pm", "[", 
      RowBox[{
      "m", ",", " ", "t", ",", " ", "eb", ",", " ", "ea", ",", " ", "nc"}], 
      "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "0", ",", " ", "nc"}], "}"}]}], "]"}]}]}], "Input",\

