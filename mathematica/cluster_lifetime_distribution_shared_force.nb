Cell[BoxData[{
 RowBox[{
  RowBox[{"tmean", "[", 
   RowBox[{"n_", ",", " ", "f_", ",", " ", "eb_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"lmd", "[", 
      RowBox[{"i", ",", " ", "f", ",", " ", "eb"}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tvar", "[", 
   RowBox[{"n_", ",", " ", "f_", ",", " ", "eb_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"lmd", "[", 
       RowBox[{"i", ",", " ", "f", ",", " ", "eb"}], "]"}], "^", "2"}]}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tsens", "[", 
   RowBox[{"n_", ",", " ", "f_", ",", " ", "eb_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "i"}], "*", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "eb"}], " ", "+", " ", 
        RowBox[{"f", " ", 
         RowBox[{"xb", "/", 
          RowBox[{"(", 
           RowBox[{"i", "*", "kT"}], ")"}]}]}]}], "]"}], "/", 
      RowBox[{
       RowBox[{"lmd", "[", 
        RowBox[{"i", ",", " ", "f", ",", " ", "eb"}], "]"}], "^", "2"}]}]}], 
    ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tvarsens", "[", 
   RowBox[{"n_", ",", " ", "f_", ",", " ", "eb_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "*", "i", "*", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "eb"}], " ", "+", " ", 
        RowBox[{"f", " ", 
         RowBox[{"xb", "/", 
          RowBox[{"(", 
           RowBox[{"i", "*", "kT"}], ")"}]}]}]}], "]"}], "/", 
      RowBox[{
       RowBox[{"lmd", "[", 
        RowBox[{"i", ",", " ", "f", ",", " ", "eb"}], "]"}], "^", "3"}]}]}], 
    ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}]}], "Input",\

