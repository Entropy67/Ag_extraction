Cell[CellGroupData[{

Cell["2. Time measurement with rebinding", "Subsection",
 CellChangeTimes->{{3.809559932310865*^9, 
  3.809559943874058*^9}},ExpressionUUID->"4f50c4d2-9009-47b1-97d0-\
311bf174a0ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TmeanOn", "[", 
    RowBox[{"n0_", ",", " ", "ka_", ",", " ", "kb_", ",", " ", "k0_"}], "]"}],
    ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"k0", "/", 
           RowBox[{"(", 
            RowBox[{"ka", "+", "kb"}], ")"}]}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}]}], "/", "i"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n0"}], "}"}]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"ka", "+", "kb"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TvarOn", "[", 
    RowBox[{"n0_", ",", "ka_", ",", " ", "kb_", ",", " ", "k0_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"gam", ",", " ", "lmd", ",", " ", "ret"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lmd", "=", 
       RowBox[{"ka", "+", "kb"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gam", "=", 
       RowBox[{"k0", "/", "lmd"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ret", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Binomial", "[", 
                RowBox[{"n0", ",", " ", "i"}], "]"}], 
               RowBox[{
                RowBox[{"gam", "^", "i"}], " ", "/", "i"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "n0"}], "}"}]}], "]"}], ")"}], "^",
            "2"}], " ", "+", "\[IndentingNewLine]", " ", 
          RowBox[{"2", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Binomial", "[", 
               RowBox[{"n0", ",", " ", "i"}], "]"}], 
              RowBox[{
               RowBox[{"gam", "^", "i"}], "/", 
               RowBox[{"i", "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "n0"}], "}"}]}], "]"}]}], "+", 
          "\[IndentingNewLine]", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"i", "^", "2"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n0"}], "}"}]}], "]"}]}], ")"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ka", "+", "kb", "+", "k0"}], ")"}], "^", "2"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"ret", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Binomial", "[", 
                  RowBox[{"n0", ",", " ", "i"}], "]"}], 
                 RowBox[{
                  RowBox[{"gam", "^", "i"}], " ", "/", "i"}]}], "+", 
                RowBox[{"1", "/", "i"}]}], ")"}], "^", "2"}], ",", 
             RowBox[{"{", 
