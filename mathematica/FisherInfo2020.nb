 RowBox[{
  RowBox[{"TimeFisherInfoApprox", "[", 
   RowBox[{"n0_", ",", " ", "ka_", ",", " ", "kb_", ",", " ", "F_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"xbar", ",", " ", "i0"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"xbar", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"xa", "*", "ka"}], " ", "+", " ", 
         RowBox[{"xb", "*", "kb"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"ka", "+", "kb"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"i0", "=", 
      RowBox[{"F", " ", 
       RowBox[{"xbar", "/", "kT"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"i0", "<", "n0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ret", " ", "=", " ", 
        RowBox[{"2", "i0", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n0", "+", "1", "-", "i0"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"n0", "+", "1", "-", "i0"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n0", "+", "i0"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "i0"}], ")"}]}], "]"}], "^", "2"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"ka", "/", "kb"}]}], ")"}], "^", "2"}]}]}]}], ",", 
       RowBox[{"ret", "=", 
        RowBox[{"3", "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"ka", " ", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "F"}], 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"xb", "-", "xa"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"n0", " ", "kT"}], ")"}]}]}], "]"}], "/", 
              "kb"}]}]}], ")"}], "^", "2"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", 
      RowBox[{"xbar", ",", " ", "i0"}], "]"}], ";", "\[IndentingNewLine]", 
     "ret"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
