Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"1", "-", 
    RowBox[{"Erf", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t0", "-", "al"}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "+", 
    RowBox[{"Erf", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t1", "-", "al"}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "-", 
    RowBox[{
     RowBox[{"Erf", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t0", "-", "al"}], ")"}], "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], 
     RowBox[{"Erf", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t1", "-", "al"}], ")"}], "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t1", ",", " ", "t0", ",", " ", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.819553455375814*^9, 3.8195534922466516`*^9}, {
   3.819562522198347*^9, 3.819562542792535*^9}, 3.819562612348523*^9},
