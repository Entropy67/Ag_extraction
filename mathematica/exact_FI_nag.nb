Cell[CellGroupData[{

Cell["Numerical approximation of Fisher information", "Subsubsection",
 CellChangeTimes->{{3.819735310945307*^9, 3.8197353214023848`*^9}, {
  3.8197378109282627`*^9, 
  3.819737819150754*^9}},ExpressionUUID->"37f4b914-b622-460a-96b2-\
cd937bcb1c13"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "NgetFisherInfo", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NgetFisherInfo", "[", 
   RowBox[{
   "n0_", ",", " ", "k2off_", ",", " ", "F_", ",", " ", "kon_", ",", " ", 
    RowBox[{"de_", ":", " ", 
     RowBox[{"1", "/", " ", "1000"}]}], ",", " ", 
    RowBox[{"check_", ":", "False"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "info", ",", " ", "prob0", ",", " ", "prob1", ",", " ", "prob2"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"N0", "=", "n0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"prob0", "=", 
      RowBox[{
       RowBox[{"solverN", "[", 
        RowBox[{"k2off", ",", " ", "F", ",", " ", "kon"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"prob1", " ", "=", " ", 
      RowBox[{
       RowBox[{"solverN", "[", 
        RowBox[{
         RowBox[{"k2off", " ", 
          RowBox[{"Exp", "[", "de", "]"}]}], ",", " ", "F", ",", " ", "kon"}],
         "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"N0", ">", "15"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"prob2", " ", "=", " ", 
          RowBox[{
           RowBox[{"solverN", "[", 
            RowBox[{
             RowBox[{"k2off", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"-", "de"}], "]"}]}], ",", " ", "F", ",", " ", "kon"}],
             "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"info", " ", "=", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"prob2", "[", 
                   RowBox[{"[", "ix", "]"}], "]"}], "-", 
                  RowBox[{"prob1", "[", 
                   RowBox[{"[", "ix", "]"}], "]"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "de"}], ")"}]}], ")"}], "^", "2"}], "/", 
             RowBox[{"prob0", "[", 
              RowBox[{"[", "ix", "]"}], "]"}]}], " ", ",", " ", 
            RowBox[{"{", 
             RowBox[{"ix", ",", " ", "1", ",", " ", 
              RowBox[{"N0", "+", "1"}]}], "}"}]}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"info", " ", "=", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"prob0", "[", 
                 RowBox[{"[", "ix", "]"}], "]"}], "-", 
                RowBox[{"prob1", "[", 
                 RowBox[{"[", "ix", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", "de", ")"}]}], ")"}], "^", "2"}], "/", 
           RowBox[{"prob0", "[", 
            RowBox[{"[", "ix", "]"}], "]"}]}], " ", ",", " ", 
          RowBox[{"{", 
           RowBox[{"ix", ",", " ", "1", ",", " ", 
            RowBox[{"N0", "+", "1"}]}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", 
      RowBox[{"prob0", ",", " ", "prob1", ",", " ", "prob2"}], "]"}], ";", 
     "\[IndentingNewLine]", "info"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
