Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ntot", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KT", " ", "=", " ", 
   RowBox[{"414", "/", "100"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eta", "[", 
    RowBox[{"ka_", ",", " ", "kb_"}], "]"}], ":=", 
   RowBox[{"ka", " ", "/", " ", 
    RowBox[{"(", 
     RowBox[{"ka", " ", "+", " ", "kb"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"koff", "[", 
    RowBox[{"eb_", ",", " ", "xb_", ",", " ", "f_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"10", "^", "3"}], ")"}], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "eb"}], " ", "+", " ", 
      RowBox[{"f", " ", 
       RowBox[{"xb", " ", "/", " ", "KT"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lmd", "[", 
   RowBox[{"i_", ",", " ", "f_", ",", " ", "eb_", ",", " ", "ea_"}], "]"}], ":=", 
  RowBox[{"1000", "i", "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "ea"}], "+", 
       RowBox[{"f", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"i", "*", "KT"}], ")"}]}]}]}], "]"}], "+", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "eb"}], "+", 
       RowBox[{"f", "*", 
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"i", "*", "KT"}], ")"}]}]}]}], "]"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmean", "[", 
   RowBox[{"eb_", ",", " ", "ea_", ",", "  ", "f_", ",", "n_"}], "]"}], ":=", 
  
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"lmd", "[", 
      RowBox[{"i", ",", " ", "f", ",", " ", "eb", ",", " ", "ea"}], "]"}]}], 
    ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}]}], "Input",\

