Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"Pm", ",", " ", "mAve"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pm", "[", 
    RowBox[{
    "m_", ",", " ", "t_", ",", " ", "eb_", ",", "ea_", ",", " ", "nc_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xa", "=", "1.5"}], ",", " ", 
       RowBox[{"xb", "=", "2.0"}], ",", " ", 
       RowBox[{"f", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"koffAPC", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"ea", ",", " ", "xa", ",", " ", "f"}], "]"}]}], ";", 
