Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox[
      RowBox[{"Erf", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "al"}], "+", "t0"}], 
        SqrtBox["2"]], "]"}], "2"]}], ")"}], "-", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"al", "-", "t0"}], ")"}], "2"]}]], " ", 
    SqrtBox[
     FractionBox["2", "\[Pi]"]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"Erf", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "al"}], "+", "t0"}], 
        SqrtBox["2"]], "]"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"t1", "-", "t0"}], ")"}]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"t1", "-", "t0"}], "]"}], "2"],
    SeriesData[$CellContext`t1, $CellContext`t0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`t1, $CellContext`t0, {
   1 - Erf[2^Rational[-1, 2] (-$CellContext`al + $CellContext`t0)]^2, -
    E^(Rational[-1, 2] ($CellContext`al - $CellContext`t0)^2) (2/Pi)^
     Rational[1, 2] (-1 + 
     Erf[2^Rational[-1, 2] (-$CellContext`al + $CellContext`t0)])}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.8195534935107517`*^9, 3.819562543361371*^9, 
