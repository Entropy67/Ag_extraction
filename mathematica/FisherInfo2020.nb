Cell[BoxData[
 RowBox[{
  RowBox[{"fidelityPefect", "[", 
   RowBox[{"eb_", ",", " ", "nB_", ",", " ", "dE_", ",", " ", 
    RowBox[{"a_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"prob", "[", 
      RowBox[{"y", ",", " ", "nB", ",", " ", "eb", ",", " ", "a"}], "]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"prob", "[", 
          RowBox[{"y1", ",", " ", "nB", ",", " ", 
           RowBox[{"eb", "-", "dE"}], ",", " ", "a"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"y1", ",", " ", "0", ",", " ", "y"}], "}"}]}], "]"}], ")"}],
       "^", 
      RowBox[{"(", 
       RowBox[{"nB", "-", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
   "]"}]}]], "Input",
