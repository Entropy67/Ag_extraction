Cell[CellGroupData[{

Cell["3. Derivative of PDF with respect to Eb", "Subsubsection",
 CellChangeTimes->{{3.819506517800765*^9, 3.819506526113665*^9}, 
   3.819508601129019*^9},ExpressionUUID->"99276378-7299-4b8f-83fa-\
1ba1c5f9f96c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"dpdf", ",", " ", "dpdf0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dpdf", "[", 
    RowBox[{"t_", ",", " ", "n_", ",", " ", "f_", ",", " ", "eb_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{
       "dpt", ",", " ", "tmp", ",", " ", "ix", ",", " ", "jx", ",", " ", 
        "part1", ",", " ", "part2", ",", " ", "part3", ",", " ", "prods"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"prods", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lmd", "[", 
              RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"lmd", "[", 
                RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}], "-", 
               RowBox[{"lmd", "[", 
                RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}]}], 
              ")"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"jx", ",", " ", "1", ",", " ", 
              RowBox[{"ix", "-", "1"}]}], "}"}]}], "]"}], "*", 
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lmd", "[", 
              RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"lmd", "[", 
                RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}], "-", 
               RowBox[{"lmd", "[", 
                RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}]}], 
              ")"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"jx", ",", " ", 
              RowBox[{"ix", "+", "1"}], ",", " ", "n"}], "}"}]}], "]"}]}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"ix", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"dpt", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"ix", "=", "1"}], ",", 
        RowBox[{"ix", "<", 
         RowBox[{"n", "+", "1"}]}], ",", " ", 
        RowBox[{"ix", "++"}], ",", " ", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tmp", "=", "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{"part1", " ", "=", " ", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"lmd", "[", 
                RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}]}], "*", 
              "t"}], "]"}], "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"lmd", "[", 
                RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}], "*", 
               "t"}]}], ")"}], "*", 
            RowBox[{"prods", "[", 
             RowBox[{"[", "ix", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"part2", "=", "0"}], ";", 
          RowBox[{"part3", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"jx", "=", "1"}], ",", 
            RowBox[{"jx", "<", 
             RowBox[{"n", "+", "1"}]}], ",", " ", 
            RowBox[{"jx", "++"}], ",", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"jx", "\[NotEqual]", "ix"}], ",", " ", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"part2", " ", "=", " ", 
                  RowBox[{"part2", " ", "+", " ", 
                   RowBox[{
                    RowBox[{"prods", "[", 
                    RowBox[{"[", "ix", "]"}], "]"}], 
                    RowBox[{"lmd", "[", 
                    RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}], " ", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"lmd", "[", 
                    RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}]}], 
                    "t"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"lmd", "[", 
                    RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}], "-", 
                    RowBox[{"lmd", "[", 
                    RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}]}], 
                    ")"}]}]}]}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"part3", " ", "=", " ", 
                  RowBox[{"part3", "+", " ", 
                   RowBox[{
                    RowBox[{"prods", "[", 
                    RowBox[{"[", "jx", "]"}], "]"}], " ", "*", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"lmd", "[", 
                    RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}], "^",
                     "2"}], " ", ")"}], "*", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"lmd", "[", 
                    RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}]}], 
                    "t"}], "]"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"lmd", "[", 
                    RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"lmd", "[", 
                    RowBox[{"ix", ",", " ", "f", ",", " ", "eb"}], "]"}], "-", 
                    RowBox[{"lmd", "[", 
                    RowBox[{"jx", ",", " ", "f", ",", " ", "eb"}], "]"}]}], 
                    ")"}]}], ")"}]}]}]}]}]}]}], "\[IndentingNewLine]", "]"}], 
              ";"}], "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"dpt", " ", "=", "  ", 
           RowBox[{"dpt", " ", "-", 
            RowBox[{"ix", "*", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "eb"}], " ", "+", 
               RowBox[{"f", " ", 
                RowBox[{"xb", "/", 
                 RowBox[{"(", 
                  RowBox[{"ix", "*", "kT"}], ")"}]}]}]}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"part1", " ", "+", "part2", " ", "-", " ", "part3"}], 
              ")"}]}]}]}]}], "\[IndentingNewLine]", "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", " ", 
       RowBox[{
       "tmp", ",", " ", "ix", ",", " ", "jx", ",", " ", "part1", ",", " ", 
        "part2", ",", " ", "part3", ",", " ", "prods"}], "]"}], ";", 
      "\[IndentingNewLine]", "dpt"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dpdf0", "[", 
    RowBox[{"t_", ",", " ", "n_", ",", " ", "f_", ",", " ", "eb_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", "lmd0", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"lmd0", "=", 
       RowBox[{"lmd", "[", 
        RowBox[{"1", ",", " ", "0", ",", " ", "eb"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"-", "n"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", "eb"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "lmd0"}], "*", "t"}], "]"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "lmd0"}], "*", "t"}], "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"n", "-", "2"}], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"lmd0", "*", "t"}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "lmd0"}], " ", "t"}], "]"}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}], "lmd0", " ", "t", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "lmd0"}], " ", "t"}], "]"}]}]}], ")"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<dpdf[t, n, f, eb]=\>\"", ",", 
   RowBox[{"N", "[", " ", 
    RowBox[{
     RowBox[{"dpdf", "[", 
      RowBox[{"1", ",", " ", "50", ",", " ", "0", ",", " ", "1"}], "]"}], ",",
      " ", "5"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<expect: dpdf0=\>\"", ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"dpdf0", "[", 
      RowBox[{"1", ",", " ", "50", ",", " ", "0", ",", " ", "1"}], "]"}], ",",
      " ", "6"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<numerical delta pdf=\>\"", ",", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"pdf", "[", 
         RowBox[{"1", ",", " ", "50", ",", " ", "0", ",", " ", 
          RowBox[{"1", "+", 
           RowBox[{"1", "/", "20"}]}]}], "]"}], ",", " ", "6"}], "]"}], "-", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"pdf", "[", 
         RowBox[{"1", ",", " ", "50", ",", " ", "0", ",", " ", 
          RowBox[{"1", "-", 
           RowBox[{"1", "/", "20"}]}]}], "]"}], ",", " ", "6"}], "]"}]}], 
     ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "/", "10"}], ")"}]}]}], "]"}]}], "Input",
