Cell[CellGroupData[{

Cell["antigen number distribution", "Subsubsection",
 CellChangeTimes->{{3.822860754035965*^9, 
  3.8228607593015423`*^9}},ExpressionUUID->"86c13b93-4861-41f4-8bba-\
ba2a7cbcc7d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"disN", "[", 
   RowBox[{"n_", ",", " ", "l0_", ",", " ", "t_", ",", " ", "t0_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Binomial", "[", 
    RowBox[{"l0", ",", "n"}], "]"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"t", "/", 
       RowBox[{"(", 
        RowBox[{"t", "+", "t0"}], ")"}]}], ")"}], "^", "n"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"t0", "/", 
       RowBox[{"(", 
        RowBox[{"t", "+", "t0"}], ")"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"l0", "-", "n"}], ")"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eta", "[", 
   RowBox[{"ta_", ",", "tb_", ",", " ", "f_"}], "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{"ta", " ", "/", " ", "tb"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"f", "*", 
        RowBox[{"0.5", "/", "4.012"}]}], "]"}]}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.822861445999366*^9, 3.82286148812414*^9}},
 CellLabel->
  "In[719]:=",ExpressionUUID->"c30e7b13-3b14-416b-b36b-c15695e9884b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"antigenNumberProx", "[", 
   RowBox[{"s_", ",", " ", "n0_", ",", "ta_", ",", " ", "tb_", ",", "F_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "ux", ",", "qi", ",", " ", "j", ",", " ", "u", ",", " ", "part1", ",", 
       " ", "part2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qi", "[", 
       RowBox[{"j_", ",", " ", "ux_"}], "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"eta", "[", 
        RowBox[{"ta", ",", " ", "tb", ",", " ", 
         RowBox[{"F", "/", 
          RowBox[{"(", 
           RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}], " ", 
       RowBox[{
        RowBox[{"Exp", "[", "ux", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"eta", "[", 
           RowBox[{"ta", ",", " ", "tb", ",", " ", 
            RowBox[{"F", "/", 
             RowBox[{"(", 
              RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}], "+", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"ta", ",", " ", "tb", ",", " ", 
             RowBox[{"F", "/", 
              RowBox[{"(", 
               RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}], " ", 
           RowBox[{"Exp", "[", "ux", "]"}]}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"u", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"qi", "[", 
              RowBox[{"j", ",", " ", "ux"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", " ", "n0"}], "}"}]}], "]"}], 
           "\[Equal]", "s"}], ",", 
          RowBox[{"{", 
           RowBox[{"ux", ",", " ", "0"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"part1", " ", "=", " ", 
      RowBox[{
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"eta", "[", 
           RowBox[{"ta", ",", " ", "tb", ",", " ", 
            RowBox[{"F", "/", 
             RowBox[{"(", 
              RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}], "+", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"ta", ",", " ", "tb", ",", " ", 
             RowBox[{"F", "/", 
              RowBox[{"(", 
               RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}], 
           RowBox[{"Exp", "[", "u", "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", " ", "n0"}], "}"}]}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "u"}], " ", "s"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"part2", " ", "=", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"qi", "[", 
            RowBox[{"j", ",", " ", "u"}], "]"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"qi", "[", 
              RowBox[{"j", ",", "u"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n0"}], "}"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ret", " ", "=", " ", 
      RowBox[{"part1", "/", " ", "part2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", 
      RowBox[{
      "ux", ",", " ", "qi", ",", " ", "j", ",", " ", "u", ",", " ", "part1", 
       ",", " ", "part2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"N", "[", 
      RowBox[{"ret", ",", " ", "3"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
  "In[721]:=",ExpressionUUID->"5e6ec9e6-63ec-41e5-af02-6b78ff507bed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"antigenNumber", "[", 
   RowBox[{
   "s_", ",", " ", "n0_", ",", " ", "ta_", ",", " ", "tb_", ",", " ", "F_", 
    ",", " ", 
    RowBox[{"tot_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"ret", ",", " ", "toti"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"s", "\[Equal]", "0"}], ",", " ", 
       RowBox[{"ret", "=", 
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"1", "-", 
           RowBox[{"eta", "[", 
            RowBox[{"ta", ",", " ", "tb", ",", " ", 
             RowBox[{"F", "/", 
              RowBox[{"(", 
               RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n0"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"(*", "else", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"s", "\[Equal]", "n0"}], ",", " ", 
          RowBox[{"ret", "=", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{"eta", "[", 
              RowBox[{"ta", ",", " ", "tb", ",", " ", 
               RowBox[{"F", "/", 
                RowBox[{"(", 
                 RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "n0"}], "}"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "else", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", " ", "[", 
             RowBox[{
              RowBox[{"tot", "\[Equal]", "0"}], ",", "\[IndentingNewLine]", 
              RowBox[{"toti", " ", "=", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{"antigenNumberProx", "[", 
                  RowBox[{
                  "sj", ",", "n0", ",", "ta", ",", " ", "tb", ",", " ", "F"}],
                   "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"sj", ",", "1", ",", 
                   RowBox[{"n0", "-", "1"}]}], "}"}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"toti", " ", "=", " ", "tot"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ret", " ", "=", " ", 
             RowBox[{
              RowBox[{"antigenNumberProx", "[", 
               RowBox[{
               "s", ",", " ", "n0", ",", " ", "ta", ",", " ", "tb", ",", " ", 
                "F"}], "]"}], "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"Product", "[", 
                  RowBox[{
                   RowBox[{"1", "-", 
                    RowBox[{"eta", "[", 
                    RowBox[{"ta", ",", " ", "tb", ",", " ", 
                    RowBox[{"F", "/", 
                    RowBox[{"(", 
                    RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}]}], 
                   ",", 
                   RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "n0"}], "}"}]}], "]"}], "-", 
                 RowBox[{"Product", "[", 
                  RowBox[{
                   RowBox[{"eta", "[", 
                    RowBox[{"ta", ",", " ", "tb", ",", " ", 
                    RowBox[{"F", "/", 
                    RowBox[{"(", 
                    RowBox[{"n0", "-", "j", "+", "1"}], ")"}]}]}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "n0"}], "}"}]}], "]"}]}], 
                ")"}], "/", "toti"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
         "]"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "ret"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.822860887770206*^9, 3.8228608879807796`*^9}},
 CellLabel->
  "In[722]:=",ExpressionUUID->"d75a0a07-4d43-4b95-9583-c3841fbbeb51"],

