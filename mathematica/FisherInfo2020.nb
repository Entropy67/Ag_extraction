  3.8219005274856*^9},ExpressionUUID->"f75f72da-70a4-49bb-9782-1dd9e111b320"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fidelityNag0", "[", 
     RowBox[{"eb1_", ",", " ", "n_", ",", " ", 
      RowBox[{"nB_", ":", "2"}], ",", " ", 
      RowBox[{"dE_", ":", "0.1"}]}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Binomial", "[", 
        RowBox[{"n", ",", " ", "n0"}], "]"}], 
       RowBox[{
        RowBox[{"eta", "[", "eb1", "]"}], "^", "n0"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"eta", "[", "eb1", "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"n", "-", "n0"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Binomial", "[", 
             RowBox[{"n", ",", " ", "n1"}], "]"}], 
            RowBox[{
             RowBox[{"eta", "[", 
              RowBox[{"eb1", "-", "dE"}], "]"}], "^", "n1"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"eta", "[", 
                RowBox[{"eb1", "-", "dE"}], "]"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"n", "-", "n1"}], ")"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n1", ",", " ", "0", ",", " ", 
             RowBox[{"n0", "-", "1"}]}], "}"}]}], "]"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"nB", "-", "1"}], ")"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n0", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fidelityNagApprox0", "[", 
     RowBox[{"eb1_", ",", " ", "n_", ",", " ", 
      RowBox[{"nB_", ":", "2"}], ",", 
      RowBox[{"dE_", ":", "0.1"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", "nB"}], "+", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"nB", "-", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"nB", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"2", "nB"}], "-", "1"}], "]"}]}], ")"}]}], 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"n", " ", 
         RowBox[{"Exp", "[", "eb1", "]"}]}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", "eb1", "]"}]}], ")"}]}], "*", "dE"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"n", " ", 
           RowBox[{"Exp", "[", "eb1", "]"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Exp", "[", "eb1", "]"}]}], ")"}]}], "*", "dE"}], ")"}], 
      "^", "2"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.8219016271889687`*^9, 3.8219016555076723`*^9}, {
  3.821901691653618*^9, 3.821901713596559*^9}, {3.821901861437621*^9, 
