Cell[CellGroupData[{

Cell["optimal Eb", "Subsection",
 CellChangeTimes->{{3.826134976496702*^9, 
  3.826134979506482*^9}},ExpressionUUID->"05919c23-554d-487a-9bf2-\
eb2bb7a14a2d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"OptimalEb", "[", 
    RowBox[{"ka_", ",", "n0_", ",", " ", "f_", ",", " ", "func_"}], "]"}], ":=", 
   RowBox[{"ArgMax", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"func", "[", 
        RowBox[{"n0", ",", "ka", ",", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "eb"}], "]"}], ",", " ", "f"}], "]"}], ",", " ", 
       RowBox[{"eb", ">", "0"}], ",", " ", 
       RowBox[{"eb", "<", "20"}]}], "}"}], ",", " ", "eb"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OptimalEb", "[", 
   RowBox[{"1", ",", " ", "20", ",", " ", "200", ",", " ", "NagFisherInfo"}], 
   "]"}], "-", 
  RowBox[{"200", "*", 
   RowBox[{"0.5", "/", 
    RowBox[{"(", 
     RowBox[{"n0", "*", "4.012"}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.826134983232485*^9, 3.826135036579932*^9}, {
