 RowBox[{
  RowBox[{"ea", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kT", "=", 
   RowBox[{"4012", "/", "1000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$MaxExtraPrecision", " ", "=", " ", "200"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lmd", "[", 
   RowBox[{"i_", ",", " ", "f_", ",", " ", "eb_", ",", " ", "ea_"}], "]"}], ":=", 
  RowBox[{"1000", "i", "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "ea"}], "+", 
       RowBox[{"f", "*", 
        RowBox[{"xa", "/", 
         RowBox[{"(", 
          RowBox[{"i", "*", "kT"}], ")"}]}]}]}], "]"}], "+", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "eb"}], "+", 
       RowBox[{"f", "*", 
        RowBox[{"xb", "/", 
         RowBox[{"(", 
          RowBox[{"i", "*", "kT"}], ")"}]}]}]}], "]"}]}], ")"}]}]}]}], "Input",\

