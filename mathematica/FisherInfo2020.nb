Cell[BoxData[{
 RowBox[{
  RowBox[{"eta", "[", " ", "eb_", "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", "eb"}], "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{
  "fidelityNag", ",", " ", "fidelityNagApprox", ",", " ", "eb1", ",", " ", 
   "n", ",", " ", "nB", ",", " ", "dE"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fidelityNag", "[", 
   RowBox[{"eb1_", ",", " ", "n_", ",", " ", 
    RowBox[{"nB_", ":", "2"}]}], "]"}], ":=", 
  RowBox[{"1.0", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Binomial", "[", 
       RowBox[{"n", ",", " ", "n0"}], "]"}], 
      RowBox[{"(", 
       RowBox[{"n0", "-", 
        RowBox[{"n", " ", 
         RowBox[{"eta", "[", "eb1", "]"}]}]}], ")"}], 
      RowBox[{
       RowBox[{"eta", "[", "eb1", "]"}], "^", "n0"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"eta", "[", "eb1", "]"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"n", "-", "n0"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Binomial", "[", 
            RowBox[{"n", ",", " ", "n1"}], "]"}], 
           RowBox[{
            RowBox[{"eta", "[", "eb1", "]"}], "^", "n1"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"eta", "[", "eb1", "]"}]}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"n", "-", "n1"}], ")"}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"n1", ",", " ", "0", ",", " ", 
            RowBox[{"n0", "-", "1"}]}], "}"}]}], "]"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"nB", "-", "1"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n0", ",", " ", "1", ",", " ", "n"}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fidelityNagApprox", "[", 
   RowBox[{"eb1_", ",", " ", "n_", ",", " ", 
    RowBox[{"nB_", ":", "2"}]}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"nB", "-", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"nB", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"2", "nB"}], "-", "1"}], "]"}]}], ")"}]}], 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"n", " ", 
      RowBox[{"Exp", "[", "eb1", "]"}]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Exp", "[", "eb1", "]"}]}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.8218945712848454`*^9, 3.821894577533284*^9}, {
