Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fisherInfoF", "[", 
   RowBox[{
   "t_", ",", " ", "eb_", ",", " ", "ea_", ",", " ", "f_", ",", " ", "nc_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xaF", "=", 
       RowBox[{"3", "/", "2"}]}], ",", " ", 
      RowBox[{"xbF", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "q", ",", " ", "dPdE", ",", "faF", ",", "fbF", ",", "koffAPCF", ",", 
       " ", "koffbF"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "m_", "]"}], ":=", 
      RowBox[{
       RowBox[{"koff", "[", 
        RowBox[{"eb", ",", " ", "xbF", ",", " ", 
         RowBox[{"f", "/", "m"}]}], "]"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"koff", "[", 
          RowBox[{"ea", ",", " ", "xaF", ",", " ", 
           RowBox[{"f", "/", "m"}]}], "]"}], " ", "+", " ", 
