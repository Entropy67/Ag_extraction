Notebook[{
Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"xb1", ",", "xb2", ",", "kT"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xb1", "=", 
    RowBox[{"3", "/", "2"}]}], ";", 
   RowBox[{"xb2", "=", "2"}], ";", 
   RowBox[{"kT", "=", 
    RowBox[{"4012", "/", "1000"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"bond", " ", "length", " ", "and", " ", "thermal", " ", "force"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kaF", "[", 
     RowBox[{"ka_", ",", "f_"}], "]"}], ":=", 
    RowBox[{"ka", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"f", "*", 
       RowBox[{"xb1", "/", "kT"}]}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "off", " ", "rate", " ", "under", " ", "force", " ", "for", " ", "APC"}], 
    "-", 
    RowBox[{"Ag", " ", "bond"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kbF", "[", 
     RowBox[{"kb_", ",", "f_"}], "]"}], ":=", 
    RowBox[{"kb", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"f", "*", 
       RowBox[{"xb2", "/", "kT"}]}], "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "off", " ", "rate", " ", "under", " ", "force", " ", "for", " ", "BCR"}], 
    "-", 
    RowBox[{"Ag", " ", "bond"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etaF", "[", 
    RowBox[{"ka_", ",", " ", "kb_", ",", " ", "f_"}], "]"}], ":=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"kbF", "[", 
        RowBox[{"kb", ",", " ", "f"}], "]"}], "/", 
       RowBox[{"kaF", "[", 
        RowBox[{"ka", ",", " ", "f"}], "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lamda", "[", 
     RowBox[{"ka_", ",", "kb_", ",", "f_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"kaF", "[", 
      RowBox[{"ka", ",", " ", "f"}], "]"}], "+", 
     RowBox[{"kbF", "[", 
      RowBox[{"kb", ",", "f"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"total", " ", "off", " ", "rates"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.8254741169436607`*^9, 3.825474147592722*^9}},
 CellLabel->
  "In[271]:=",ExpressionUUID->"8dfa47c3-bb44-4fff-a0c0-0976afdcba43"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"n0", ",", " ", "ea", ",", " ", "eb", ",", " ", "de"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TmeanFE", "[", 
    RowBox[{"n0_", ",", " ", "ea_", ",", "eb_", ",", 
     RowBox[{"F_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"i", "*", 
        RowBox[{"lamda", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", "ea"}], "]"}], ",", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "eb"}], "]"}], ",", 
          RowBox[{"F", "/", "i"}]}], "]"}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n0"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DklNag", "[", 
   RowBox[{"n0_", ",", " ", "ea_", ",", "eb_", ",", " ", "de_"}], "]"}], ":=", 
  RowBox[{"n0", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       RowBox[{"Exp", "[", 
        RowBox[{"eb", "-", "ea", "+", "de"}], "]"}]}], "]"}], "-", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       RowBox[{"Exp", "[", 
        RowBox[{"eb", "-", "ea"}], "]"}]}], "]"}], "-", 
     RowBox[{"de", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"ea", "-", "eb"}], "]"}]}], ")"}]}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DklTau", "[", 
    RowBox[{"n0_", ",", " ", "ea_", ",", " ", "eb_", ",", " ", "de_"}], "]"}],
    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"lmd1", ",", " ", "lmd2"}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"lmd1", "=", 
       RowBox[{"lamda", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", "ea"}], "]"}], ",", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "eb"}], "]"}], ",", " ", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lmd2", "=", 
       RowBox[{"lamda", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", "ea"}], "]"}], ",", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "eb"}], "-", "de"}], "]"}], ",", " ", "0"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"lmd1", "/", "lmd2"}], "]"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"lmd1", "-", "lmd2"}], ")"}], 
        RowBox[{"TmeanFE", "[", 
         RowBox[{"n0", ",", " ", "ea", ",", " ", "eb"}], "]"}]}], "-", "1", 
       "+", 
       RowBox[{"1", "/", "n0"}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n0", "-", "1"}], ")"}], 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"lmd2", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "lmd2"}], " ", "t"}], "]"}], 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "lmd1"}], " ", "t"}], "]"}]}], ")"}], "^", 
             "n0"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "lmd2"}], " ", "t"}], "]"}]}], ")"}]}]}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
         "]"}]}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"DklNag", "[", 
  RowBox[{"10", ",", " ", "0", ",", " ", "0", ",", " ", "1.0"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"DklTau", "[", 
    RowBox[{"10", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "]"}], ",", 
   " ", "5"}], "]"}]}], "Input",
