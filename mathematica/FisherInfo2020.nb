Cell[BoxData[
 RowBox[{
  RowBox[{"hill", "[", 
   RowBox[{"x_", ",", " ", "xc_", ",", " ", "n_", ",", " ", "f0_"}], "]"}], ":=", 
  RowBox[{"f0", "/", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{
