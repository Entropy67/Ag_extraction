              RowBox[{"m1", "+", "1"}], ",", " ", "F", ",", " ", "f1"}], 
             "]"}], " ", "*", " ", 
            RowBox[{"(", 
             RowBox[{"m1", "+", "1"}], ")"}], 
            RowBox[{"Delta", "[", 
             RowBox[{
              RowBox[{"m1", "+", "1"}], ",", " ", "m2"}], "]"}], 
            RowBox[{"Delta", "[", 
             RowBox[{
              RowBox[{"n1", "-", "1"}], ",", " ", "n2"}], "]"}], 
            RowBox[{"Theta", "[", 
             RowBox[{"n1", "-", "1"}], "]"}], 
            RowBox[{"Theta", "[", 
