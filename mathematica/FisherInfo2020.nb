Cell[CellGroupData[{

Cell["2.5 Consider info efficiency, i.e. info / T", "Subsection",
 CellChangeTimes->{{3.809563635085968*^9, 
  3.809563648922433*^9}},ExpressionUUID->"73490a3a-6e99-4dfe-9a05-\
b3cd6fd9a0f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"TimeFisherInfoEff", "[", 
   RowBox[{"n0_", ",", "ka_", ",", "kb_", ",", "F_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"TimeFisherInfo", "[", 
    RowBox[{"n0", ",", " ", "ka", ",", "kb", ",", " ", "F"}], "]"}], "/", 
   RowBox[{"TmeanF", "[", 
    RowBox[{"n0", ",", " ", "ka", ",", " ", "kb", ",", " ", "F"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NagFisherInfoEff", "[", 
   RowBox[{"n0_", ",", " ", "ka_", ",", " ", "kb_", ",", "F_"}], "]"}], ":=", 
  
  RowBox[{
   RowBox[{"NagFisherInfo", "[", 
    RowBox[{"n0", ",", " ", "ka", ",", " ", "kb", ",", " ", "F"}], "]"}], "/", 
   RowBox[{"TmeanF", "[", 
    RowBox[{"n0", ",", " ", "ka", ",", " ", "kb", ",", " ", "F"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TimeFisherInfoOnEff", "[", 
   RowBox[{"n0_", ",", " ", "ka_", ",", " ", "kb_", ",", " ", "kon_"}], "]"}],
   ":=", 
  RowBox[{
   RowBox[{"TimeFisherInfoOn", "[", 
    RowBox[{"n0", ",", " ", "ka", ",", " ", "kb", ",", " ", "kon"}], "]"}], 
   "/", " ", 
   RowBox[{"TmeanOn", "[", 
    RowBox[{"n0", ",", " ", "ka", ",", " ", "kb", ",", " ", "kon"}], 
    "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.809563669658999*^9, 
