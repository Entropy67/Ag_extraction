Cell[BoxData[
 RowBox[{
  RowBox[{"normal", "[", 
   RowBox[{"x_", ",", " ", "mu_", ",", " ", "sigma_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "Pi"}], "]"}], "sigma"}], ")"}]}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "mu"}], ")"}], "^", "2"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"sigma", "^", "2"}]}], ")"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.822541070596753*^9, 3.8225411051369658`*^9}},
 CellLabel->
  "In[4937]:=",ExpressionUUID->"21dd5cdc-05ee-4b4d-ae03-3339d7087f04"],

