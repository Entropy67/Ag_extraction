Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"PmF", ",", " ", "nc"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PmF", "[", 
    RowBox[{
    "m_", ",", " ", "t_", ",", " ", "eb_", ",", " ", "f_", ",", " ", "ea_", 
     ",", " ", "nc_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xa", "=", 
        RowBox[{"3", "/", "2"}]}], ",", " ", 
       RowBox[{"xb", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"fa", ",", " ", "fb", ",", " ", "koffAPC", ",", " ", "koffb"}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"fa", "=", " ", 
       RowBox[{"f", "*", 
        RowBox[{"xa", " ", "/", " ", "KT"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fb", " ", "=", " ", 
       RowBox[{"f", " ", "*", " ", 
        RowBox[{"xb", " ", "/", " ", "KT"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"koffAPC", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"ea", ",", " ", "xa", ",", " ", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"koffb", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"eb", ",", " ", "xb", ",", " ", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{"a", ",", " ", "ret"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "[", "n_", "]"}], ":=", 
       RowBox[{
        RowBox[{"n", "*", "koffAPC", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"fa", " ", "/", " ", "n"}], "]"}]}], " ", "+", " ", 
        RowBox[{"n", " ", "*", " ", "koffb", " ", "*", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"fb", "/", "n"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"m", "\[Equal]", "nc"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{"ret", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"a", "[", "m", "]"}]}], "t"}], "]"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"m", ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{"ret", " ", "=", " ", 
             RowBox[{
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{"a", "[", "i", "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"m", "+", "1"}], ",", " ", "nc"}], "}"}]}], "]"}], 
              "*", 
              RowBox[{"Sum", "[", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"a", "[", "m", "]"}], "-", 
                    RowBox[{"a", "[", "i", "]"}]}], ")"}], "t"}], "]"}], " ", 
                   "-", " ", "1"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Product", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"a", "[", "j", "]"}], " ", "-", " ", 
                    RowBox[{"a", "[", "i", "]"}]}], ")"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "m", ",", " ", 
                    RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], 
                   RowBox[{"Product", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"a", "[", "j", "]"}], "-", 
                    RowBox[{"a", "[", "i", "]"}]}], ")"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", 
                    RowBox[{"i", "+", "1"}], ",", " ", "nc"}], "}"}]}], 
                    "]"}]}], ")"}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"m", "+", "1"}], ",", " ", "nc"}], "}"}]}], "]"}], 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"a", "[", "m", "]"}]}], "t"}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ret", "=", " ", 
             RowBox[{
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{"a", "[", "i", "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "1", ",", " ", "nc"}], "}"}]}], "]"}],
               "*", 
              RowBox[{"Sum", "[", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"a", "[", "i", "]"}]}], "t"}], "]"}], "-", "1"}], 
                    ")"}]}], "/", 
                    RowBox[{"a", "[", "i", "]"}]}], " ", "+", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"a", "[", "1", "]"}]}], "t"}], "]"}], "-", "1"}], 
                    ")"}], "/", 
                    RowBox[{"a", "[", "1", "]"}]}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Product", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"a", "[", "j", "]"}], " ", "-", " ", 
                    RowBox[{"a", "[", "i", "]"}]}], ")"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", "1", ",", " ", 
                    RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], 
                   RowBox[{"Product", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"a", "[", "j", "]"}], "-", 
                    RowBox[{"a", "[", "i", "]"}]}], ")"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", " ", 
                    RowBox[{"i", "+", "1"}], ",", " ", "nc"}], "}"}]}], 
                    "]"}]}], ")"}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "2", ",", " ", "nc"}], "}"}]}], 
               "]"}]}]}]}], "\[IndentingNewLine]", "]"}], ";"}], "}"}]}], 
       "]"}], ";", "\[IndentingNewLine]", "ret"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mAveF", "[", 
    RowBox[{
    "t_", ",", " ", "eb_", ",", " ", "f_", ",", " ", "ea_", ",", " ", "nc_"}],
     "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{"PmF", "[", 
       RowBox[{
       "m", ",", " ", "t", ",", "eb", ",", "f", ",", "ea", ",", " ", "nc"}], 
       "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "nc"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PmFInfEa", "[", 
    RowBox[{
    "m_", ",", " ", "t_", ",", " ", "eb_", ",", " ", "f_", ",", " ", "nc_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{"xb", "=", "2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"fa", ",", " ", "fb", ",", " ", "koffAPC", ",", " ", "koffb"}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"fb", " ", "=", " ", 
       RowBox[{"f", " ", "*", " ", 
        RowBox[{"xb", " ", "/", " ", "KT"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"koffb", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"eb", ",", " ", "xb", ",", " ", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{"a", ",", " ", "ret"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "[", "n_", "]"}], ":=", " ", 
       RowBox[{"n", " ", "*", " ", "koffb", " ", "*", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"fb", "/", "n"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"m", "\[Equal]", "nc"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{"ret", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"a", "[", "m", "]"}]}], "t"}], "]"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"m", ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{"ret", " ", "=", " ", 
             RowBox[{
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{"a", "[", "i", "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"m", "+", "1"}], ",", " ", "nc"}], "}"}]}], "]"}], 
              "*", 
              RowBox[{"Sum", "[", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"a", "[", "m", "]"}], "-", 
                    RowBox[{"a", "[", "i", "]"}]}], ")"}], "t"}], "]"}], " ", 
                   "-", " ", "1"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Product", "[", 
                    RowBox[{
                    RowBox[{"(", 
