Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"prob", "[", 
    RowBox[{"t", ",", " ", "n", ",", " ", "e", ",", " ", "a"}], "]"}], ",", 
