Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"fisherInfo", ",", " ", "fisherInfo2"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fisherInfo", "[", 
    RowBox[{"t_", ",", " ", "eb_", ",", " ", "nc_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xa", "=", "1.5"}], ",", " ", 
       RowBox[{"xb", "=", "2.0"}], ",", " ", 
       RowBox[{"ea", "=", "10"}], ",", " ", 
       RowBox[{"f", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"koffAPC", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"ea", ",", " ", "xa", ",", " ", "f"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"koffb", " ", "=", " ", 
       RowBox[{"koff", "[", 
        RowBox[{"eb", ",", " ", "xb", ",", " ", "f"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"koffb", " ", "+", " ", "koffAPC"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"etaT", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{"nc", ",", " ", "mx"}], "]"}], " ", 
         RowBox[{"etaT", "^", "mx"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "etaT"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"nc", "-", "mx", "-", "2"}], ")"}]}], " ", 
         RowBox[{"koffb", "^", "2"}], " ", 
         RowBox[{"t", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"nc", " ", "*", " ", "etaT"}], " ", "-", " ", "mx"}], 
           ")"}], "^", "2"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mx", ",", "0", ",", " ", "nc"}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fisherInfo2", "[", 
   RowBox[{"t_", ",", " ", "eb_", ",", " ", "ea_", ",", " ", "nc_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xa", "=", "1.5"}], ",", " ", 
      RowBox[{"xb", "=", "2.0"}], ",", " ", 
      RowBox[{"f", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"koffAPC", " ", "=", " ", 
      RowBox[{"koff", "[", 
       RowBox[{"ea", ",", " ", "xa", ",", " ", "f"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"koffb", " ", "=", " ", 
      RowBox[{"koff", "[", 
       RowBox[{"eb", ",", " ", "xb", ",", " ", "f"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"koffb", " ", "+", " ", "koffAPC"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nc", " ", 
      RowBox[{"koffb", "^", "2"}], " ", 
      RowBox[{"t", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "t"}], "]"}], "/", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "a"}], " ", "t"}], "]"}]}], ")"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fisherInfo", "[", 
   RowBox[{"50", ",", " ", "10", ",", " ", "20"}], "]"}], "*", 
  "1.0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fisherInfo2", "[", 
   RowBox[{"50", ",", " ", "10", ",", "10", ",", " ", "20"}], "]"}], "*", 
  "1.0"}]}], "Input",
