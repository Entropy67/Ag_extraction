        RowBox[{"eb", ",", " ", "xb", ",", " ", "f"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"koffb", " ", "+", " ", "koffAPC"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "\[Equal]", "0"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", "\[Equal]", "nc"}], ",", " ", "1", ",", " ", "0"}], 
         "]"}], ",", "\[IndentingNewLine]", 
