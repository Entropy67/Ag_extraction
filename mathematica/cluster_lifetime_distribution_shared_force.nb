     " ", "shared", " ", "force"}], ",", " ", 
    RowBox[{"without", " ", "rebinding"}]}], "*)"}]}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"pdf", "[", 
    RowBox[{
    "t_", ",", " ", "n_", ",", " ", "f_", ",", " ", "eb_", ",", " ", "ea_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"pt", ",", " ", "tmp", ",", " ", "ix", ",", " ", "jx"}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"pt", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"ix", "=", "1"}], ",", 
        RowBox[{"ix", "<", 
         RowBox[{"n", "+", "1"}]}], ",", " ", 
        RowBox[{"ix", "++"}], ",", " ", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tmp", "=", "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"jx", "=", "1"}], ",", 
            RowBox[{"jx", "<", 
             RowBox[{"n", "+", "1"}]}], ",", " ", 
            RowBox[{"jx", "++"}], ",", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"jx", "\[NotEqual]", "ix"}], ",", " ", 
                "\[IndentingNewLine]", 
                RowBox[{"tmp", " ", "=", " ", 
                 RowBox[{"tmp", "*", 
                  RowBox[{
                   RowBox[{"lmd", "[", 
                    RowBox[{
                    "jx", ",", " ", "f", ",", " ", "eb", ",", " ", "ea"}], 
                    "]"}], "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"lmd", "[", 
                    RowBox[{
                    "jx", ",", " ", "f", ",", " ", "eb", ",", " ", "ea"}], 
                    "]"}], "-", 
                    RowBox[{"lmd", "[", 
                    RowBox[{
                    "ix", ",", " ", "f", ",", " ", "eb", ",", " ", "ea"}], 
                    "]"}]}], ")"}]}]}]}]}], "\[IndentingNewLine]", "]"}], 
              ";"}], "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"pt", " ", "=", " ", 
           RowBox[{"pt", "+", 
            RowBox[{"tmp", "*", 
             RowBox[{"lmd", "[", 
              RowBox[{"ix", ",", " ", "f", ",", " ", "eb", ",", " ", "ea"}], 
              "]"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"lmd", "[", 
                 RowBox[{
                 "ix", ",", " ", "f", ",", " ", "eb", ",", " ", "ea"}], 
                 "]"}]}], "*", "t"}], "]"}]}]}]}], ";"}], 
         "\[IndentingNewLine]", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{"tmp", ",", " ", "ix", ",", " ", "jx"}], "]"}], ";", 
      "\[IndentingNewLine]", "pt"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Distribution", " ", "of", " ", "cluster", " ", "lifetime", " ", "no", 
     " ", "force"}], ",", " ", 
    RowBox[{"without", " ", "rebinding"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdf0", "[", 
   RowBox[{"t_", ",", " ", "n_", ",", " ", "eb_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", "lmd0", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lmd0", "=", 
      RowBox[{"lmd", "[", 
       RowBox[{"1", ",", " ", "0", ",", " ", "eb"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "*", "lmd0", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "lmd0"}], "*", "t"}], "]"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "lmd0"}], "*", "t"}], "]"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
