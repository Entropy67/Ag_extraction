Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TimeFisherInfo", "[", 
        RowBox[{"40", ",", "0", ",", "1", ",", 
         RowBox[{"40", "fi"}]}], "]"}], ",", 
       RowBox[{"TimeFisherInfo", "[", 
        RowBox[{"40", ",", "0.1", ",", "1", ",", 
         RowBox[{"40", "fi"}]}], "]"}], ",", " ", 
       RowBox[{"TimeFisherInfo", "[", 
        RowBox[{"40", ",", "1", ",", "1", ",", 
         RowBox[{"40", "fi"}]}], "]"}]}], 
      RowBox[{"(*", 
       RowBox[{"2", "*", "40", " ", 
        RowBox[{"(", 
         RowBox[{"fi", "*", 
          RowBox[{"1.5", "/", "kT"}]}], ")"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", " ", "fi", "*", 
          RowBox[{"1.5", "/", "kT"}]}], "]"}], " ", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"fi", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"3", "-", "2"}], ")"}], "/", "kT"}]}]}], "]"}], "^", 
         "2"}], 
        RowBox[{"(", 
         RowBox[{"1", "/", "1"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"fi", ",", " ", "0.001", ",", " ", "500"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0.1", ",", " ", "100"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(k\), \(a\)]\)=0\>\"", ",", " ", 
          "\"\<\!\(\*SubscriptBox[\(k\), \
\(a\)]\)=0.1\!\(\*SubscriptBox[\(k\), \(b\)]\)\>\"", ",", " ", 
          "\"\<\!\(\*SubscriptBox[\(k\), \(a\)]\)=\!\(\*SubscriptBox[\(k\), \
\(b\)]\)\>\""}], " ", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", "0.4"}], "}"}]}], "]"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"2", "*", "40", " ", 
      RowBox[{"(", 
       RowBox[{"fi", "*", 
        RowBox[{"2", "/", "kT"}]}], ")"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "fi", "*", 
        RowBox[{"2", "/", "kT"}]}], "]"}], " ", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"fi", "*", 
          RowBox[{"2", "/", "kT"}]}]}], "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"fi", ",", " ", "0.001", ",", " ", "500"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Black", ",", " ", "Dashed"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<force per bond, F/N\>\"", ",", " ", "\"\<Fisher information\>\""}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameStyle", "\[Rule]", 
    RowBox[{"Directive", "[", "15", "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
