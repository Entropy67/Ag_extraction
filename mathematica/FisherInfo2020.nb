Cell[BoxData[{
 RowBox[{
  RowBox[{"s", "[", 
   RowBox[{"f_", ",", " ", "sigma_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sqrt", "[", "2", "]"}], "/", "sigma"}], " ", 
   RowBox[{"InverseErf", "[", 
    RowBox[{
     RowBox[{"2", "f"}], "-", "1"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lhsG", "[", 
   RowBox[{"m_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"s", "[", 
      RowBox[{
       RowBox[{"fx", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "m"}], ")"}]}], ",", " ", "n"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"fx", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], "/", 
   "m"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhsG", "[", 
   RowBox[{"m_", ",", " ", "n_"}], "]"}], ":=", " ", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"n", "^", "2"}], ")"}]}], ")"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "-", "1"}], ")"}], "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"m", "^", "2"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "m"}], "-", "1"}], ")"}]}], ")"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.821675523082955*^9, 3.8216755698529053`*^9}, {
   3.821675601523671*^9, 3.8216756059651823`*^9}, {3.821675672827023*^9, 
