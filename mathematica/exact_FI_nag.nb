           RowBox[{"kon", "*", 
            RowBox[{"(", 
             RowBox[{"n1", "+", "1"}], ")"}], 
            RowBox[{"Delta", "[", 
             RowBox[{
              RowBox[{"m1", "-", "1"}], ",", "m2"}], "]"}], 
            RowBox[{"Delta", "[", 
