Cell[CellGroupData[{

Cell["4. Fisher information", "Subsubsection",
 CellChangeTimes->{{3.819510716590795*^9, 
  3.819510721989491*^9}},ExpressionUUID->"6bc74935-ede0-480a-89b3-\
1b12d792ae02"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fisherinfo", "[", 
    RowBox[{"n_", ",", " ", "f_", ",", " ", "eb_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"tm", ",", " ", "info", ",", " ", "iz", ",", " ", "tz"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tm", " ", "=", 
       RowBox[{"10", "*", 
        RowBox[{"tmean", "[", 
         RowBox[{"n", ",", " ", "f", ",", " ", "eb"}], "]"}]}]}], ";", 
      RowBox[{"ngrid", "=", "200"}], ";", "\[IndentingNewLine]", 
      RowBox[{"dtx", "=", 
       RowBox[{"tm", "/", "ngrid"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"False", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<tm=\>\"", ",", " ", "tm"}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"info", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"iz", "=", "1"}], ",", " ", 
        RowBox[{"iz", "\[LessEqual]", "ngrid"}], ",", " ", 
        RowBox[{"iz", "++"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tz", " ", "=", 
           RowBox[{"tm", "*", 
            RowBox[{"iz", "/", "ngrid"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"info", " ", "+=", 
           RowBox[{"dtx", "*", " ", 
            RowBox[{"N", "[", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dpdf", "[", 
                 RowBox[{"tz", ",", " ", "n", ",", " ", "f", ",", " ", "eb"}],
                  "]"}], "^", "2"}], "/", 
               RowBox[{"pdf", "[", 
                RowBox[{"tz", ",", " ", "n", ",", " ", "f", ",", " ", "eb"}], 
                "]"}]}], ",", " ", "6"}], "]"}]}]}]}], "\[IndentingNewLine]", 
         "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{
       "tm", ",", " ", "iz", ",", "  ", "dtx", ",", " ", "ngrid", ",", " ", 
        "tz"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"N", "[", 
       RowBox[{"info", ",", " ", "10"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fisherinfo0", "[", 
    RowBox[{"n_", ",", "  ", "eb_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "eb"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"lmd", "[", 
        RowBox[{"1", ",", "0", ",", " ", "eb"}], " ", "]"}], "^", "2"}], 
      ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}], 
         RowBox[{"t", "^", "2"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "t"}], "]"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"Exp", "[", 
             RowBox[{"-", "t"}], "]"}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"n", "-", "3"}], ")"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], "]"}]}],
      ")"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fisherinfoGaussian", "[", 
    RowBox[{"n_", ",", " ", "f_", ",", " ", "eb_", ",", " ", 
     RowBox[{"alpha_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"tsens", "[", 
         RowBox[{"n", " ", ",", "f", ",", " ", "eb"}], "]"}], ")"}], "^", 
       "2"}], "+", 
      RowBox[{"alpha", "*", "2", "*", 
       RowBox[{
        RowBox[{
         RowBox[{"tvarsens", "[", 
          RowBox[{"n", ",", " ", "f", ",", " ", "eb"}], "]"}], "^", "2"}], 
        "/", 
        RowBox[{"tvar", "[", 
         RowBox[{"n", ",", " ", "f", ",", " ", "eb"}], "]"}]}]}]}], ")"}], 
    "/", 
    RowBox[{"tvar", "[", 
     RowBox[{"n", ",", " ", "f", ",", " ", "eb"}], "]"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<fisher info=\>\"", ",", " ", 
     RowBox[{"fisherinfo", "[", 
      RowBox[{"20", ",", " ", "0", ",", " ", "0"}], "]"}]}], "]"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<expected=\>\"", ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"fisherinfo0", "[", 
     RowBox[{"20", ",", " ", "0"}], "]"}], "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Gaussian approx=\>\"", ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"fisherinfoGaussian", "[", 
     RowBox[{"20", ",", " ", "0", ",", " ", "0"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.819510743255595*^9, 3.819511179210721*^9}, {
