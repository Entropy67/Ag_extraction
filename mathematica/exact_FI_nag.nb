         RowBox[{"ka", " ", 
          RowBox[{"Kf", "[", 
           RowBox[{"1", ",", "f", ",", " ", "f1"}], "]"}]}], ")"}]}]}]}], 
     ")"}]}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nMeanF", "[", 
    RowBox[{"n0_", ",", "ka_", ",", "kb_", ",", "F_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"etaF", "[", 
      RowBox[{"ka", ",", " ", "kb", ",", " ", 
       RowBox[{"F", "/", "i"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", " ", "n0"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nVarF", "[", 
    RowBox[{"n0_", ",", "ka_", ",", "kb_", ",", "F_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"etaF", "[", 
       RowBox[{"ka", " ", ",", " ", "kb", ",", " ", 
        RowBox[{"F", "/", "i"}]}], "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"etaF", "[", 
         RowBox[{"ka", ",", " ", "kb", ",", " ", 
          RowBox[{"F", "/", "i"}]}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "n0"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nSensF", "[", 
