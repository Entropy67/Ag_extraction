       RowBox[{"nVarF", "[", 
        RowBox[{"n0", ",", " ", "ka", ",", " ", "kb", ",", " ", "F"}], 
        "]"}]}], ")"}], "^", "2"}], "/", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
