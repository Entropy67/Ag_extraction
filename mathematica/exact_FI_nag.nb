Cell[CellGroupData[{

Cell["Exact evaluation of Fisher information", "Subsubsection",
 CellChangeTimes->{{3.81974065579316*^9, 
  3.8197406637800903`*^9}},ExpressionUUID->"b9098320-3119-47bb-8936-\
0ab3117e0b68"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "getFisherInfo", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"getFisherInfo", "[", 
   RowBox[{
   "n0_", ",", " ", "k2off_", ",", " ", "F_", ",", " ", "kon_", ",", " ", 
    "k1off_", ",", " ", "f1_", ",", " ", "f2_"}], " ", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"N0", "=", "n0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", 
      RowBox[{
      "kb", ",", "  ", "pTable", ",", " ", "dpTable", ",", " ", "info"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pTable", " ", "=", " ", 
      RowBox[{
       RowBox[{"solver", "[", 
        RowBox[{
        "kb", ",", " ", "F", ",", " ", "kon", ",", " ", "k1off", ",", " ", 
         "f1", ",", " ", "f2", ",", "False", ",", " ", "False"}], "]"}], "[", 
       
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dpTable", " ", "=", " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", "pTable", "]"}], ",", " ", "kb"}], "]"}], ",", 
        " ", "kb"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"info", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"kb", "^", "2"}]}], 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pTable", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", 
          RowBox[{"dpTable", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "pTable", "]"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", 
      RowBox[{"pTable", ",", " ", "dpTable"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"info", " ", "=", " ", 
      RowBox[{"info", "/.", " ", 
       RowBox[{"kb", "\[Rule]", "k2off"}]}]}], ";", "\[IndentingNewLine]", 
     "info"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"getFisherInfo", "[", 
  RowBox[{
  "3", ",", " ", "1.0", ",", "10", ",", " ", "5", ",", " ", "1", ",", " ", 
   RowBox[{"f1", "=", 
    RowBox[{"4012", "/", "1500"}]}], ",", 
   RowBox[{"f2", "=", 
    RowBox[{"4012", "/", "2000"}]}]}], " ", "]"}]}], "Input",
 CellChangeTimes->{{3.8197406684577093`*^9, 3.819740921762743*^9}, {
