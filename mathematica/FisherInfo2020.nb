Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"e", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       FractionBox["1", "n"]}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"e", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "n"]}]], " ", 
  SuperscriptBox["t", 
   FractionBox["a", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "n"}]]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       RowBox[{"e", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "n"]], "+", 
     SuperscriptBox["t", "a"]}], ")"}], 
   FractionBox["1", 
    RowBox[{"1", "-", "n"}]]]}]], "Output",
 CellChangeTimes->{3.821926181136489*^9},
 CellLabel->
  "Out[165]=",ExpressionUUID->"855e0d84-c12f-45bf-bcc1-9d60464b96b0"]
}, Open  ]],

